  "criteria": [
    {
      "id": "HU-PROD-05/CA-01",
      "source": "08_Historias_de_Usuario.md:254",
      "text": "Dado que cambio el estado de un producto a «Inactivo», cuando un vendedor intenta buscarlo en mostrador, entonces el producto queda excluido de la venta.",
      "scope": "Implementado adicionalmente; pendiente de auditoría",
      "execution": "NO EJECUTADO como auditoría completa; regresión automática ejecutada"
    },
    {
      "id": "HU-PROD-05/CA-02",
      "source": "08_Historias_de_Usuario.md:255",
      "text": "Dado que cambio el estado de un producto a «Activo», cuando un vendedor lo busca en mostrador, entonces vuelve a figurar disponible para cobrar con sus existencias y precio.",
      "scope": "Implementado adicionalmente; pendiente de auditoría",
      "execution": "NO EJECUTADO como auditoría completa; regresión automática ejecutada"
    },
    {
      "id": "HU-PROD-05/CA-03",
      "source": "08_Historias_de_Usuario.md:256",
      "text": "Dado que un producto se encuentra inactivo, cuando el administrador revisa el catálogo, entonces se muestra con la etiqueta «Inactivo» y conserva todo su historial.",
      "scope": "Implementado adicionalmente; pendiente de auditoría",
      "execution": "NO EJECUTADO como auditoría completa; regresión automática ejecutada"
    }
  ],
